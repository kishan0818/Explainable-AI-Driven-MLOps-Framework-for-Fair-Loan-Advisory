        "Moratorium of 12 months on principal repayment",
        "Tenor up to 6 years including moratorium",
        "Quick processing and disbursal"
      ],
      "required_documents": [
        "GST registration certificate",
        "Bank account statements (Feb 2020)",
        "Audited financial statements",
        "Self-certification of eligibility",
        "Loan application form"
      ],
      "subsidy_or_interest": "Interest rate capped at 9.25% for loans up to ₹2 crore and EBLR+3.5% for above ₹2 crore",
      "validity": "Extended multiple times, currently available with modifications"
    },
