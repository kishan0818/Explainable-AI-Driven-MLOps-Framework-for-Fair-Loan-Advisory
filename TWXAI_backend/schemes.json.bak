      "subsidy_or_interest": "Interest charged on utilized amount as per Mudra loan terms, typically EBLR+3.25%",
      "validity": "Available for eligible Mudra borrowers"
    },
    {
      "id": "eclgs",
      "name": "Emergency Credit Line Guarantee Scheme (ECLGS)",
      "category": "Emergency Credit / COVID Relief",
      "url": "https://www.eclgs.com",
