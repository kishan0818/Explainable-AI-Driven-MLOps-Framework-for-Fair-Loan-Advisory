      },
      "benefits": [
        "Easy access to credit for PMJDY account holders",
        "Digital payment facility",
        "Building credit history for future borrowings",
        "Financial inclusion of unbanked population"
      ],
      "required_documents": [
        "PMJDY account details",
        "Aadhaar card and PAN card",
        "Income proof or ITR",
        "Bank account statements",
        "Address verification documents"
      ],
      "subsidy_or_interest": "Interest rates as per bank's policy, typically 1.5-3% per month on outstanding balance",
      "validity": "Ongoing under PMJDY mission"
    },
    {
      "id": "mudra_card",
      "name": "Mudra Card",
      "category": "Working Capital / Digital Payments",
      "url": "https://www.mudra.org.in",
