      "eligibility": {
        "beneficiaries": "Individual and MSME borrowers whose accounts were classified as standard but not in default for more than 30 days as on March 31, 2021",
        "loan_amount": "Restructuring of existing loans as per borrower's repayment capacity",
        "collateral": "Existing collateral arrangements continue",
        "special_conditions": "One-time restructuring, implementation by September 30, 2021 with extensions"
      },
      "benefits": [
        "Asset classification benefit during restructuring period",
        "Moratorium on payments up to 2 years",
        "Conversion of interest into funded interest term loan",
        "Extension of residual tenor up to 2 years"
      ],
      "required_documents": [
        "Application for restructuring",
        "Financial statements and income proof",
        "Impact assessment due to COVID-19",
        "Revised repayment schedule",
        "Board resolution (for entities)"
      ],
      "subsidy_or_interest": "Interest rates as per original loan terms, conversion of unpaid interest into FITL at same rate",
      "validity": "Framework implemented with specific timelines, benefits continue as per restructured terms"
    }
