# ==============================================================================
# TWXAI ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
#
# QUICK SETUP INSTRUCTIONS:
# ------------------------------------------------------------------------------
# 1. FOR BACKEND (Python FastAPI):
#    Copy this file to the backend directory:
#      cp .env.example TWXAI_backend/.env
#    (or on Windows PowerShell: Copy-Item .env.example TWXAI_backend/.env)
#
# 2. FOR FRONTEND (Next.js 14):
#    Copy this file to .env.local in the root directory:
#      cp .env.example .env.local
#    (or on Windows PowerShell: Copy-Item .env.example .env.local)
#
# 3. Fill in your actual API keys and secrets below.
#    Local development defaults will work out-of-the-box for offline ML features.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (TWXAI_backend/.env)
# ------------------------------------------------------------------------------

# --- Supabase Database Credentials (PostgreSQL) ---
# Used for persistent applicant records, audit logs, and underwriter sessions.
# If not configured, the backend automatically falls back to local SQLite.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# --- LLM & External Search Providers ---
# Used by the LangGraph Multi-Agent RAG advisor for conversational reasoning.
PERPLEXITY_API_KEY="your-perplexity-api-key"
NVIDIA_API_KEY="your-nvidia-api-key"
SERPAPI_API_KEY="your-serpapi-key"

# --- Security, Authentication & Admin Access ---
# Admin secret and credentials for the Underwriter portal & MLOps endpoints.
ADMIN_SECRET="twxai_admin"
ADMIN_EMAIL="admin@twxai.com"
ADMIN_PASSWORD="secure_admin_password"
RECAPTCHA_SECRET_KEY="your-google-recaptcha-secret-key"

# --- Observability & LLMOps (Langfuse) ---
# Used for real-time agent trace logging, token telemetry, and session replays.
# Sign up free at https://cloud.langfuse.com
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key"
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key"
LANGFUSE_HOST="https://cloud.langfuse.com"

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (.env.local)
# ------------------------------------------------------------------------------

# --- FastAPI Backend URL ---
# Local backend endpoint (default: http://localhost:8000)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# --- Frontend Supabase Public Credentials ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Google reCAPTCHA v3 Site Key ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-google-recaptcha-site-key"
